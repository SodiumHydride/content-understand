{
  "name": "content-understand",
  "version": "0.2.5",
  "private": true,
  "description": "Multimodal content understanding with a polished desktop UI",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "lint:py": "ruff check .",
    "lint:py:fix": "ruff check --fix .",
    "format": "ruff format .",
    "build:sidecar": "pyinstaller sidecar.spec --noconfirm --distpath sidecar-dist",
    "build:electron": "electron-vite build && electron-builder",
    "dist": "npm run build:sidecar && npm run build:electron",
    "dist:win": "npm run build:sidecar && electron-vite build && electron-builder --win",
    "dist:mac": "npm run build:sidecar && electron-vite build && electron-builder --mac"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/noto-sans-sc": "^5.2.9",
    "@fontsource/noto-serif-sc": "^5.2.9",
    "@fontsource/source-serif-4": "^5.2.9",
    "@tanstack/react-query": "^5.101.0",
    "@uiw/react-md-editor": "^4.1.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "i18next": "^24.2.2",
    "katex": "^0.17.0",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.4.1",
    "react-markdown": "^9.0.3",
    "react-syntax-highlighter": "^16.1.1",
    "react-virtuoso": "^4.18.7",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "sonner": "^2.0.7",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^42.0.0",
    "electron-builder": "^26.15.0",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^7.0.0"
  }
}
